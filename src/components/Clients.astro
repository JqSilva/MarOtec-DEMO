---
import { Image } from 'astro:assets';
import { empresas } from '../data/empresas';
---

<section class="py-20 text-white bg-gradient-to-b from-[#101828] via-gray-800 to-gray-900 overflow-hidden">
  <div class="container px-5 mx-auto max-w-7xl">
    <div class="flex flex-col text-center w-full mb-12">
      <h2 class="text-4xl font-extrabold mb-4">Empresas que Confían en Nosotros</h2>
      <p class="mx-auto leading-relaxed text-gray-400 max-w-2xl">
        Líderes del sector energético que eligen Mar Otec para capacitar a sus equipos
      </p>
    </div>

    <!-- Marquesina superior -->
    <div class="marquee-container mb-8">
      <div class="marquee">
        {[...empresas, ...empresas].map((empresa) => (
          <div class="marquee-item">
            <a href={empresa.url} target="_blank" rel="noopener noreferrer" title={empresa.nombre}>
              <div class="bg-white backdrop-blur-md border border-white/30 rounded-xl p-3 md:p-4 hover:bg-white transition-all duration-300 w-24 h-24 md:w-32 md:h-32 flex items-center justify-center shadow-lg">
                <Image 
                  src={empresa.logo} 
                  alt={empresa.nombre}
                  class="w-full h-full object-contain"
                  loading="lazy"
                />
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Marquesina inferior (dirección inversa) -->
    <div class="marquee-container">
      <div class="marquee marquee-reverse">
        {[...empresas, ...empresas].reverse().map((empresa) => (
          <div class="marquee-item">
            <a href={empresa.url} target="_blank" rel="noopener noreferrer" title={empresa.nombre}>
              <div class="bg-white backdrop-blur-md border border-white/30 rounded-xl p-3 md:p-4 hover:bg-white transition-all duration-300 w-24 h-24 md:w-32 md:h-32 flex items-center justify-center shadow-lg">
                <Image 
                  src={empresa.logo} 
                  alt={empresa.nombre}
                  class="w-full h-full object-contain"
                  loading="lazy"
                />
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-container {
    width: 100%;
    overflow: hidden;
  }

  .marquee {
    display: flex;
    gap: 2rem;
    animation: scroll 40s linear infinite;
  }

  .marquee-reverse {
    animation: scroll-reverse 40s linear infinite;
  }

  /* Móvil: animación más rápida y logos más grandes */
  @media (max-width: 768px) {
    .marquee {
      gap: 1.5rem;
      animation: scroll 20s linear infinite;
    }
    
    .marquee-reverse {
      animation: scroll-reverse 20s linear infinite;
    }
  }

  .marquee-item {
    flex-shrink: 0;
  }

  .marquee:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-reverse {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>