---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="min-h-screen pb-40 flex flex-col items-center justify-center bg-[#101828] text-white px-4">
    <div class="max-w-2xl w-full text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold mb-4 text-[#5372F0]">
            Verificación y Validación de Certificados <br class="sm:hidden" /> Mar Otec SpA
        </h1>
        <p class="text-gray-400 mb-8">Ingrese el RUT del alumno o el Código del Certificado.</p>

        <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-lg">
            <div class="flex flex-col sm:flex-row gap-4">
                <input 
                  type="text" id="rutInput" placeholder="RUT o Código de Certificado" 
                  class="flex-1 p-3 rounded-lg bg-gray-900 border border-gray-600 outline-none text-white focus:border-[#5372F0]"
                />
                <button id="btnBuscar" class="bg-[#5372F0] px-8 py-3 rounded-lg font-bold text-white cursor-pointer active:opacity-80">
                  Validar
                </button>
            </div>
        </div>

        <div id="modalResultado" class="fixed inset-0 z-50 hidden items-center justify-center p-2 sm:p-4 bg-black/90 overflow-y-auto">
            
            <div id="cardResultado" class="relative w-full max-w-md bg-[#111827] rounded-xl border border-gray-700 transition-all duration-300 opacity-0 my-auto overflow-hidden">                
                <button id="closeModal" class="absolute top-4 right-4 text-gray-400 hover:text-white p-2 bg-gray-800/50 rounded-full z-50 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>

                <!-- Contenedor Flexible -->
                <div class="flex flex-col lg:flex-row min-h-[300px] max-h-[90vh]">
                    
                    <!-- Panel de Información -->
                    <div id="panelInfo" class="p-6 sm:p-10 w-full lg:w-1/3 flex flex-col items-center lg:items-start justify-center bg-[#111827]">
                        <div class="w-full flex justify-center mb-6">
                            <img src="/images/logo.webp" alt="Logo" class="h-16 w-auto object-contain">
                        </div>

                        <div class="flex justify-center items-center w-full mb-6">
                            <h2 id="msgStatus" class="text-xl font-bold mb-6 text-center mb-4"></h2>
                        </div>
                        
                        
                        <div id="infoAlumno" class="text-left w-full space-y-4 text-gray-300 text-sm sm:text-base">
                            <div id="singleResult" class="space-y-3">
                                <p class="flex justify-between gap-4 border-b border-gray-800 pb-2"><strong>Alumno:</strong> <span id="resNombre" class="text-white text-right"></span></p>
                                <p class="flex justify-between gap-4 border-b border-gray-800 pb-2"><strong>Curso:</strong> <span id="resCurso" class="text-white text-right"></span></p>
                                <p class="flex justify-between gap-4"><strong>Estado:</strong> <span id="resEstado" class="font-bold"></span></p>
                            </div>

                            <div id="multipleResults" class="hidden space-y-3">
                                <p class="text-xs font-bold uppercase text-[#5372F0] tracking-wider">Certificados Disponibles:</p>
                                <div id="certList" class="space-y-2 max-h-48 overflow-y-auto pr-2 custom-scrollbar"></div>
                            </div>
                        </div>

                        <div class="w-full mt-8 space-y-3">
                            <button id="btnVerCertificado" class="hidden w-full py-3 bg-[#5372F0] hover:bg-[#4361EE] text-white rounded-lg font-bold transition-colors shadow-lg shadow-[#5372F0]/20">
                            Ver Documento Digital
                            </button>
                            <button id="btnEntendido" class="w-full py-3 bg-gray-800 hover:bg-gray-700 text-white rounded-lg font-bold transition-colors">
                            Cerrar
                            </button>
                        </div>
                    </div>

                    <div id="certViewer" class="hidden flex-1 bg-black p-4 items-center justify-center border-l border-gray-800">
                        <div class="relative w-full h-full min-h-[450px] lg:min-h-[600px] rounded-lg overflow-hidden bg-[#1a1a1a]">
                            <iframe id="pdfIframe" src="" class="absolute inset-0 w-full h-full border-none"></iframe>
                        </div>
                    </div>

                </div>
            </div>
        </div>


    </div>
  </section>
</Layout>

<script is:inline>
    const API_URL = "https://script.google.com/macros/s/AKfycbxIzfIzqw82K0Fs1B9pSF6gVj8eT5l7j8AZPAP1WYVUVmB1vApF7oN8hPzPjHewsUGJ/exec";

    const btn = document.getElementById('btnBuscar');
    const input = document.getElementById('rutInput');
    const modal = document.getElementById('modalResultado');
    const card = document.getElementById('cardResultado');
    const btnVer = document.getElementById('btnVerCertificado');
    const certViewer = document.getElementById('certViewer');
    const pdfIframe = document.getElementById('pdfIframe');
    const singleResult = document.getElementById('singleResult');
    const multipleResults = document.getElementById('multipleResults');
    const certList = document.getElementById('certList');
    const cardResultado = document.getElementById('cardResultado');
    const panelInfo = document.getElementById('panelInfo');

    let currentDriveUrl = null;

    async function validarEnVivo() {
        const query = input.value.trim();
        token = "mar-otec-873129831";
        if (!query) return;

        btn.innerText = "Buscando...";
        btn.disabled = true;

        const urlBusqueda = `${API_URL}?id=${encodeURIComponent(query)}?auth=${token}`;
        try {
            const response = await fetch(urlBusqueda, {
                method: 'GET'
            });
            
            const data = await response.json();
            mostrarResultado(data);
        } catch (error) {
            console.error("Error detallado:", error);
            alert("Error de conexión o token inválido.");
        } finally {
            btn.innerText = "Validar";
            btn.disabled = false;
        }
    }

    function mostrarResultado(data) {
        const msg = document.getElementById('msgStatus');
        
        // Reset
        cardResultado.classList.remove('max-w-5xl');
        cardResultado.classList.add('max-w-md');
        panelInfo.classList.add('lg:w-full');
        panelInfo.classList.remove('lg:w-1/3');

        certViewer.classList.add('hidden');
        btnVer.classList.add('hidden');
        multipleResults.classList.add('hidden');
        singleResult.classList.remove('hidden');
        pdfIframe.src = "";
        certList.innerHTML = "";
        cardResultado.style.borderColor = "#374151";

        // Mostrar Modal (Simple Opacity)
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => card.style.opacity = "1", 50);

        if (!data || data.error || (Array.isArray(data) && data.length === 0)) {
            card.style.borderColor = "#ef4444";
            msg.textContent = "No Encontrado";
            msg.className = "text-2xl font-bold text-center text-red-400";
            document.getElementById('resNombre').textContent = "---";
            document.getElementById('resCurso').textContent = "---";
            document.getElementById('resEstado').textContent = "SIN REGISTRO";
            document.getElementById('resEstado').className = "text-red-400 font-bold";
            return;
        }

        if (Array.isArray(data) && data.length > 1) {
            msg.textContent = "Certificados Encontrados";
            msg.className = "text-2xl font-bold text-center text-[#5372F0]";
            singleResult.classList.add('hidden');
            multipleResults.classList.remove('hidden');
            data.forEach(cert => {
                const b = document.createElement('button');
                b.className = "w-full text-left p-3 rounded bg-gray-800 border border-gray-700 mb-2 hover:bg-gray-600 cursor-pointer";
                b.innerHTML = `<div class="text-sm font-bold">${cert.CURSO}</div><div class="text-xs text-gray-500">Cod: ${cert.CODIGO}</div>`;
                b.onclick = () => seleccionarCertificado(cert);
                certList.appendChild(b);
            });
        } else {
            seleccionarCertificado(Array.isArray(data) ? data[0] : data);
        }
    }

    function seleccionarCertificado(cert) {
        const msg = document.getElementById('msgStatus');
        multipleResults.classList.add('hidden');
        singleResult.classList.remove('hidden');
        cardResultado.style.borderColor = "#22c55e";

        msg.textContent = "Certificado Válido";
        msg.className = "text-xl font-bold text-green-500 text-center lg:text-left";

        document.getElementById('resNombre').textContent = cert.NOMBRE;
        document.getElementById('resCurso').textContent = cert.CURSO;
        document.getElementById('resEstado').textContent = "AUTORIZADO";
        document.getElementById('resEstado').className = "text-green-400 font-bold";

        if(cert.LINK) {
            currentDriveUrl = cert.LINK.replace('/view', '/preview');
            btnVer.classList.remove('hidden');
        }
    }


    btnVerCertificado.onclick = () => {
        if(currentDriveUrl) {
            cardResultado.classList.remove('max-w-md');
            cardResultado.classList.add('max-w-5xl');

            panelInfo.classList.remove('lg:w-full');
            panelInfo.classList.add('lg:w-1/3');

            pdfIframe.src = currentDriveUrl;

            setTimeout(() => {
                certViewer.classList.remove('hidden');
                btnVerCertificado.classList.add('hidden');
            }, 150);

            if (window.innerWidth < 1024) {
                setTimeout(() => certViewer.scrollIntoView({ behavior: 'smooth' }), 100);
            }
        }
    };



    const cerrarModal = () => {
        card.style.opacity = "0";
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            pdfIframe.src = "";
        }, 200);
    };

    btnVer.addEventListener('click', () => {
        if(currentDriveUrl) {
            pdfIframe.src = currentDriveUrl;
            certViewer.classList.remove('hidden');
            btnVer.classList.add('hidden');
        }
    });

    btn.addEventListener('click', validarEnVivo);
    input.addEventListener('keypress', (e) => { if(e.key === 'Enter') validarEnVivo(); });
    document.getElementById('closeModal').addEventListener('click', cerrarModal);
    document.getElementById('btnEntendido').addEventListener('click', cerrarModal);
    modal.addEventListener('click', (e) => { if(e.target === modal) cerrarModal(); });
</script>